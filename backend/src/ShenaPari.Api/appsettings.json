{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "shenapari",
    "Audience": "shenapari-app",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Seed": {
    "Employees": []
  },
  "Campus": {
    "TimeZone": "Europe/Kyiv",
    "DaysAhead": 7
  },
  "Orders": {
    "NotPickedUpAfterMinutes": 30,
    "RatingAskAfterMinutes": 30,
    "RatingCardHours": 24,
    "RatingWindowDays": 3
  },
  "Firebase": {
    "CredentialsPath": ""
  },
  "RateLimit": {
    "AuthRequestsPerMinute": 20
  }
}